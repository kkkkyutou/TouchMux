{
  "name": "touchmux",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs --mode=single",
    "dev:single": "node scripts/dev.mjs --mode=single",
    "dev:hub": "node scripts/dev.mjs --mode=hub",
    "dev:node": "node scripts/dev.mjs --mode=node",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "check:config": "node scripts/check-config.mjs",
    "smoke:single": "node scripts/smoke-single.mjs",
    "smoke:hub-node": "node scripts/smoke-hub-node.mjs",
    "smoke:goal-guard-typing": "node scripts/smoke-goal-guard-typing.mjs",
    "smoke:goal-guard-background": "node scripts/smoke-goal-guard-background.mjs",
    "smoke:goal-guard-submit-race": "node scripts/smoke-goal-guard-submit-race.mjs",
    "smoke:goal-guard-structured-verifier": "node scripts/smoke-goal-guard-structured-verifier.mjs",
    "smoke:goal-guard-file-contains-verifier": "node scripts/smoke-goal-guard-file-contains-verifier.mjs",
    "smoke:goal-guard-json-equals-verifier": "node scripts/smoke-goal-guard-json-equals-verifier.mjs",
    "smoke:codex-observer": "node scripts/smoke-codex-observer.mjs",
    "smoke:codex-session-binding": "node scripts/smoke-codex-session-binding.mjs",
    "smoke:codex-app-server": "node scripts/smoke-codex-app-server.mjs",
    "smoke:codex-app-server-notification-cache": "node scripts/smoke-codex-app-server-notification-cache.mjs",
    "smoke:codex-live-turn": "node scripts/smoke-codex-live-turn.mjs",
    "smoke:codex-goal-guard-e2e": "node scripts/smoke-codex-goal-guard-e2e.mjs",
    "smoke:codex-app-server-goal-guard-e2e": "node scripts/smoke-codex-app-server-goal-guard-e2e.mjs",
    "smoke:app-server-bridge-probe": "node scripts/smoke-app-server-bridge-probe.mjs",
    "smoke:session-home-env": "node scripts/smoke-session-home-env.mjs",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend"
  }
}
