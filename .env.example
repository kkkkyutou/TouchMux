TOUCHMUX_PASSWORD=change-me
TOUCHMUX_JWT_SECRET=change-this-secret
TOUCHMUX_PORT=8787
TOUCHMUX_HOST=0.0.0.0
# Optional: if omitted, TouchMux falls back to the current Linux user's home directory.
# TOUCHMUX_WORKSPACE_ROOTS=/home/your-user,/srv/shared
TOUCHMUX_DATA_DIR=./backend/.data
TOUCHMUX_CODEX_COMMAND=codex --no-alt-screen
TOUCHMUX_DEFAULT_SHELL=/bin/bash
TOUCHMUX_GOAL_GUARD_INTERVAL_MS=15000
TOUCHMUX_IDLE_TIMEOUT_SEC=90
