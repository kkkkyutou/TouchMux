TOUCHMUX_RUNTIME_MODE=single
TOUCHMUX_PASSWORD=change-me
TOUCHMUX_JWT_SECRET=change-this-secret
TOUCHMUX_TOKEN_TTL_SEC=604800
TOUCHMUX_PORT=8787
TOUCHMUX_FRONTEND_PORT=5173
TOUCHMUX_HOST=0.0.0.0
# Optional but recommended for public deployments.
# TOUCHMUX_ALLOWED_ORIGINS=https://touchmux.example.com
TOUCHMUX_BACKEND_ORIGIN=http://127.0.0.1:8787
TOUCHMUX_BACKEND_WS_ORIGIN=ws://127.0.0.1:8787
# Optional: if omitted, TouchMux falls back to the current Linux user's home directory.
# TOUCHMUX_WORKSPACE_ROOTS=/home/your-user,/srv/shared
# Optional but important for systemd/service deployments.
# Codex auth, history import, and sessions under ~/.codex will follow this HOME.
# TOUCHMUX_SESSION_HOME=/home/your-user
# Optional: node identity for node mode or the local node id shown in single mode.
TOUCHMUX_NODE_ID=local
TOUCHMUX_NODE_LABEL=This Machine
# Optional: public base URL for this node, mainly for display and future extension.
# TOUCHMUX_NODE_PUBLIC_BASE_URL=https://node-a.example.com
# Optional: public WebSocket base URL for direct browser access.
# TOUCHMUX_NODE_PUBLIC_WS_BASE_URL=wss://node-a.example.com
# Required for node mode if Hub needs to connect to this machine.
# TOUCHMUX_NODE_SHARED_SECRET=replace-with-a-long-random-secret
# Optional: timeout for Hub -> Node HTTP requests.
TOUCHMUX_NODE_REQUEST_TIMEOUT_MS=8000
# Optional: allowed clock skew when Node verifies Hub request signatures.
TOUCHMUX_NODE_REQUEST_MAX_SKEW_MS=60000
# Optional: nonce cache size used by Node to reject replayed Hub requests.
TOUCHMUX_NODE_REQUEST_REPLAY_CACHE_LIMIT=10000
# Hub mode can load nodes either from JSON or a file path.
# TOUCHMUX_HUB_NODES_JSON=[{"id":"node-a","label":"Node A","baseUrl":"http://127.0.0.1:9787","sharedSecret":"replace-me","publicBaseUrl":"https://node-a.example.com","publicWsBaseUrl":"wss://node-a.example.com"}]
# TOUCHMUX_HUB_NODES_FILE=/etc/touchmux/hub-nodes.json
TOUCHMUX_DATA_DIR=./backend/.data
TOUCHMUX_MAX_UPLOAD_BYTES=2097152
# Only for local debugging. Public deployments should keep this unset/false.
# TOUCHMUX_ALLOW_INSECURE_DEFAULTS=true
TOUCHMUX_CODEX_COMMAND=codex --no-alt-screen
TOUCHMUX_DEFAULT_SHELL=/bin/bash
# Optional: delay between tmux literal paste and Enter submit.
# Increase this if Goal Guard prompt sometimes turns into a newline instead of a real submit.
TOUCHMUX_TMUX_LITERAL_SUBMIT_DELAY_MS=10000
TOUCHMUX_GOAL_GUARD_INTERVAL_MS=15000
TOUCHMUX_IDLE_TIMEOUT_SEC=90
TOUCHMUX_LOGIN_WINDOW_MS=60000
TOUCHMUX_LOGIN_MAX_ATTEMPTS=6
